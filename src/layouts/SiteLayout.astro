---
import '../styles/global.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dotgothic16/latin-400.css';
import Navbar from '../components/Navbar.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import Footer from '../components/Footer.astro';
import { locale } from '../i18n';
import { palette } from '../data/theme';
interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'id';
  canonicalPath?: string;
  ogImage?: string;
}
const {
  title = locale(Astro.url) === 'id' ? 'Fixora Studio | Pengembangan SaaS, Aplikasi & Otomasi AI' : 'Fixora Studio | SaaS, AI Automation & App Development',
  description = locale(Astro.url) === 'id' ? 'Jasa pengembangan SaaS, aplikasi mobile, website, dan otomasi AI dari Fixora Studio. Kami bantu wujudkan software sesuai kebutuhan bisnis Anda.' : 'Fixora Studio builds custom SaaS products, AI automations, mobile apps, dashboards, and high-performance websites for ambitious teams worldwide.',
  lang = locale(Astro.url),
  canonicalPath = Astro.url.pathname,
  ogImage = '/og-image.png',
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://fixorastudio.com');
const canonicalUrl = new URL(canonicalPath, siteUrl);
const socialImage = new URL(ogImage, siteUrl);
const gtmId = import.meta.env.PUBLIC_GTM_ID?.trim();
if (gtmId && !/^GTM-[A-Z0-9]+$/.test(gtmId)) throw new Error('PUBLIC_GTM_ID must be a valid GTM container ID');
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${siteUrl}#organization`, name: 'Fixora Studio', url: siteUrl.href, email: 'hitmeup@fixorastudio.com', description },
    { '@type': 'WebSite', '@id': `${siteUrl}#website`, url: siteUrl.href, name: 'Fixora Studio', publisher: { '@id': `${siteUrl}#organization` }, inLanguage: lang },
    { '@type': 'WebPage', '@id': `${canonicalUrl}#webpage`, url: canonicalUrl.href, name: title, description, inLanguage: lang, isPartOf: { '@id': `${siteUrl}#website` }, about: { '@id': `${siteUrl}#organization` } },
  ],
};
---
<style is:global define:vars={{ 'accent': palette.accent, 'accent-hover': palette.hover, 'accent-soft': palette.soft, 'accent-muted': palette.muted, 'accent-surface': palette.surface, 'accent-ink': palette.ink }}>
  :root { color-scheme:dark; }
</style>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Negotiate only once. Subsequent explicit URL changes always win.
      // If storage is unavailable, keep the requested URL instead of redirecting repeatedly.
      (() => {
        try {
          const key = 'fixora-language-visited';
          const firstVisit = localStorage.getItem(key) === null;
          localStorage.setItem(key, '1');
          const preferred = navigator.languages?.[0] || navigator.language || 'en';
          if (firstVisit && location.pathname === '/' && /^id(?:-|$)/i.test(preferred)) {
            location.replace('/id/' + location.search + location.hash);
          }
        } catch { /* Explicit URLs remain usable without browser storage. */ }
      })();
    </script>
    {gtmId && <script is:inline define:vars={{ gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
    </script>}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    {['/', '/id/'].includes(canonicalPath) && <>
      <link rel="alternate" hreflang="en" href={new URL("/", siteUrl)} />
      <link rel="alternate" hreflang="id" href={new URL("/id/", siteUrl)} />
      <link rel="alternate" hreflang="x-default" href={new URL("/", siteUrl)} />
    </>}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fixora Studio" />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Fixora Studio — software product development" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    {gtmId && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
    <SmoothScroll/><Navbar/><div class="frame"><main id="main"><slot/></main><Footer/></div>
  </body>
</html>
