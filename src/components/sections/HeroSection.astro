---
import { locale, translator, localize } from '../../i18n';
const lang = locale(Astro.url);
const t = translator(lang);
import SquareLink from '../ui/SquareLink.astro';
---
<section class="hero" aria-labelledby="hero-title"><div class="wordmark" aria-label="Fixora Studio"><span>Fixora</span><span>Studio.</span></div><div class="copy"><h1 id="hero-title">{t('Fast software for')}<br/> {t('teams that move now.')}</h1><p>{t('A software development studio building SaaS, mobile apps, and AI automation for teams worldwide.')}</p><div class="action"><SquareLink href="#work" label={t('View work')}/></div></div></section>
<style>
.hero{display:grid;grid-template-columns:49% 51%;min-height:0}.wordmark{padding:20px 40px 32px 82px;display:flex;flex-direction:column;justify-content:flex-start;font-family:var(--pixel);font-size:clamp(60px,8.2vw,122px);letter-spacing:-.055em;line-height:1.05;min-width:0}.copy{border-left:1px solid var(--line);padding:32px 38px;display:flex;flex-direction:column}h1{font-size:clamp(32px,3.9vw,58px);line-height:1.02;letter-spacing:-.035em;font-weight:400;margin:0}p{font-size:18px;line-height:1.45;color:#bdbdbd;max-width:440px;margin:20px 0 0}.action{margin-top:32px;padding-top:0}@media(max-width:1000px){.wordmark{padding-left:30px;padding-top:18px}.copy{padding:30px 24px}br{display:none}}@media(max-width:700px){.hero{grid-template-columns:1fr}.wordmark{padding:40px 24px;font-size:clamp(60px,17vw,110px)}.copy{border-left:0;border-top:1px solid var(--line)}h1{font-size:38px}p{font-size:16px}.action{margin-top:28px;padding-top:0}}
</style>
