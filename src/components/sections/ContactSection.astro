---
import { locale, translator, localize } from '../../i18n';
const lang = locale(Astro.url);
const t = translator(lang);
import { contact as contactSource } from '../../data/contact';
import CallToAction from './CallToAction.astro';
const contact = localize(contactSource, lang);
---
<section id="start" aria-labelledby="contact-title">
  <header><h2 id="contact-title">{contact.heading}</h2></header>
  <div class="contact-grid">
    <div class="contact-cell">
      <h3>{contact.title}</h3>
      <p>{contact.description}</p>
      <a class="email-link" href={`mailto:${contact.email}`}>
        <span>{contact.email}</span><span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="contact-cell sprint">
      <h3>{contact.sprint.title}</h3>
      <p>{contact.sprint.description}</p>
      <ul>{contact.sprint.benefits.map(benefit => <li>{benefit}</li>)}</ul>
    </div>
  </div>
  <div class="section-end" aria-hidden="true"></div>
  <CallToAction title={contact.note.title} description={contact.note.description} email={contact.email} />
  <div class="section-end" aria-hidden="true"></div>
</section>
<style>
  section { scroll-margin-top:50px; border-bottom:1px solid var(--line); }
  header { padding:64px 30px; border-bottom:1px solid var(--line); }
  h2 { margin:0; font-size:48px; font-weight:400; line-height:1.18; letter-spacing:-.025em; text-wrap:balance; }
  .contact-grid { display:grid; grid-template-columns:1fr 1fr; }
  .contact-cell { padding:40px; }
  .sprint { border-inline-start:1px solid var(--line); }
  h3 { margin:0 0 10px; font-size:15px; line-height:1.4; font-weight:600; }
  p { max-width:340px; margin:0; font-size:15px; line-height:1.5; color:#999; }
  .email-link { display:inline-flex; align-items:center; gap:16px; min-height:44px; max-width:100%; margin-top:18px; color:var(--accent); font-size:17px; line-height:1.5; }
  .email-link span:first-child { overflow-wrap:anywhere; text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:5px; }
  .email-link span:last-child { flex-shrink:0; }
  .email-link:hover { color:var(--accent-hover); }
  ul { display:grid; gap:12px; list-style:none; padding:0; margin:26px 0 0; }
  li { display:flex; align-items:baseline; gap:12px; color:#aaa; font-size:15px; line-height:1.4; }
  li::before { content:''; width:5px; height:5px; flex-shrink:0; background:var(--accent); }
  .section-end { height:60px; border-top:1px solid var(--line); background:repeating-linear-gradient(122deg,#0c0c0c 0 8px,#000 8px 18px); }
  @media(max-width:1000px) { h2 { font-size:38px; } }
  @media(max-width:650px) {
    header { padding:40px 24px; }
    h2 { font-size:30px; }
    .contact-grid { grid-template-columns:1fr; }
    .contact-cell { padding:32px 24px; }
    .sprint { border-inline-start:0; border-top:1px solid var(--line); }
  }
</style>
