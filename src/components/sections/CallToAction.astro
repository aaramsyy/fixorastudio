---
import { locale, translator, localize } from '../../i18n';
const lang = locale(Astro.url);
const t = translator(lang);
import FaultyTerminal from '../FaultyTerminal';
import { palette } from '../../data/theme';
interface Props { title: string; description: string; email: string; }
const { title, description, email } = Astro.props;
---
<section class="cta-banner" aria-label={t("Let's build together")}>
  <div class="terminal-background" aria-hidden="true">
    <FaultyTerminal client:visible tint={palette.accent} mouseReact={false} />
  </div>
  <div class="cta-content">
    <h2>{title}</h2>
    <p>{description}</p>
    <a href={`mailto:${email}?subject=${encodeURIComponent(`${t('Email your brief')} - Fixora Studio`)}`}>
      <span class="square" aria-hidden="true"></span>{t('Email your brief')}<span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
<style>
  .cta-banner { position:relative; isolation:isolate; display:grid; place-items:center; min-height:460px; padding:80px 24px; overflow:hidden; border-top:1px solid var(--line); background:var(--accent-ink); }
  .terminal-background { position:absolute; inset:0; z-index:-2; pointer-events:none; }
  .cta-banner::before { content:''; position:absolute; inset:0; z-index:-1; background:radial-gradient(ellipse at center,#000b 0%,#0008 60%,#0005 100%); }
  .cta-content { max-width:720px; text-align:center; }
  h2 { margin:0; font-size:clamp(32px,4vw,52px); line-height:1.12; font-weight:400; letter-spacing:-.03em; text-wrap:balance; }
  p { max-width:460px; margin:22px auto 30px; color:#d0cbd4; font-size:16px; line-height:1.6; text-wrap:pretty; }
  a { display:inline-flex; align-items:center; justify-content:center; gap:22px; min-height:48px; padding:14px 20px; background:var(--accent); color:var(--accent-ink); border:1px solid var(--accent); font:12px/1.5 var(--pixel); text-transform:uppercase; }
  a:hover { background:var(--accent-hover); border-color:var(--accent-hover); }
  .square { width:7px; height:7px; background:currentColor; }
  @media(max-width:650px) { .cta-banner { min-height:400px; padding:64px 24px; } }
</style>
