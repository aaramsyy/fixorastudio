---
import { locale, translator, localize } from '../i18n';
const lang = locale(Astro.url);
const t = translator(lang);
import { footer as footerSource } from '../data/footer';
import { services as servicesSource } from '../data/services';
const year = new Date().getFullYear();
const services = localize(servicesSource, lang);
const footer = localize(footerSource, lang);
---
<footer id="about" aria-label={t('Site footer')}>
  <div class="footer-grid">
    <div class="brand-column">
      <a class="wordmark" href="#main" aria-label={t('Fixora Studio, back to top')}>Fixora Studio.</a>
      <p>{footer.description}</p>
    </div>
    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore">{t('Explore')}</h2>
      <ul>{footer.explore.map(link => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </nav>
    <nav aria-labelledby="footer-solutions">
      <h2 id="footer-solutions">{t('Solutions')}</h2>
      <ul>{services.map(service => <li><a href="#solutions">{service.category}</a></li>)}</ul>
    </nav>
    <div class="address-column">
      <h2>{t('Address')}</h2>
      <address>{footer.address}</address>
    </div>
  </div>
  <div class="copyright">© {year} {footer.name}</div>
  <div class="footer-signature" aria-hidden="true">Fixora Studio.</div>
</footer>
<style>
  footer { scroll-margin-top:50px; }
  .footer-grid { display:grid; grid-template-columns:25% 19.5% 19.5% 36%; border-bottom:1px solid var(--line); }
  .footer-grid > * { min-width:0; padding:34px 30px 42px; border-inline-end:1px solid var(--line); }
  .footer-grid > :last-child { border-inline-end:0; }
  .wordmark { display:inline-block; color:#fafafa; font:clamp(24px,2.3vw,32px)/1.05 var(--pixel); letter-spacing:-.05em; white-space:nowrap; }
  p,address { margin:22px 0 0; max-width:310px; color:#999; font-size:14px; line-height:1.6; font-style:normal; }
  h2 { margin:0 0 18px; color:#999; font:12px/1.5 var(--pixel); text-transform:uppercase; }
  ul { display:grid; gap:8px; list-style:none; margin:0; padding:0; }
  li a { display:inline-block; padding-block:6px; font-size:14px; line-height:1.5; color:#999; }
  a:hover { color:var(--accent); }
  address { margin:0; }
  .copyright { padding:26px 30px; color:#888; font-size:12px; line-height:1.5; border-bottom:1px solid var(--line); }
  .footer-signature { overflow:hidden; height:calc(28px + .65em); padding:18px 20px 0; text-align:center; white-space:nowrap; color:#222; font:clamp(40px,12.5vw,180px)/1.15 var(--pixel); letter-spacing:-.055em; background-image:radial-gradient(#262626 .65px,transparent .65px); background-size:16px 16px; }
  @media(max-width:1000px) {
    .footer-grid { grid-template-columns:1fr 1fr; }
    .footer-grid > :nth-child(2) { border-inline-end:0; }
    .footer-grid > :nth-child(-n+2) { border-bottom:1px solid var(--line); }
  }
  @media(max-width:550px) {
    .footer-grid > * { padding:28px 24px; }
    .brand-column,.address-column { grid-column:1/-1; }
    .footer-grid > .brand-column { border-inline-end:0; }
    .footer-grid > nav:nth-child(2) { border-inline-end:1px solid var(--line); border-bottom:0; }
    .footer-grid > nav:nth-child(3) { border-inline-end:0; }
    .address-column { border-top:1px solid var(--line); }
    .copyright { padding:24px; }
    .footer-signature { padding-inline:12px; }
  }
</style>
