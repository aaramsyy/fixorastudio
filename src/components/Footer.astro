---
import { locale, translator, localize } from '../i18n';
const lang = locale(Astro.url);
const t = translator(lang);
import { footer as footerSource } from '../data/footer';
import { services as servicesSource } from '../data/services';
const year = new Date().getFullYear();
const services = localize(servicesSource, lang);
const footer = localize(footerSource, lang);
const home = lang === 'id' ? '/id/' : '/';
const isHome = Astro.url.pathname === home;
---
<footer id="about" aria-label={t('Site footer')}>
  <div class="footer-grid">
    <div class="brand-column">
      <a class="wordmark" href={isHome ? '#main' : home} aria-label={t('Fixora Studio, back to top')}>Fixora Studio.</a>
      <p>{footer.description}</p>
    </div>
    <nav aria-labelledby="footer-explore">
      <h2 id="footer-explore">{t('Explore')}</h2>
      <ul>{footer.explore.map(link => <li><a href={isHome ? link.href : `${home}${link.href}`}>{link.label}</a></li>)}</ul>
    </nav>
    <nav aria-labelledby="footer-solutions">
      <h2 id="footer-solutions">{t('Solutions')}</h2>
      <ul>{services.map(service => <li><a href={isHome ? '#solutions' : `${home}#solutions`}>{service.category}</a></li>)}</ul>

    </nav>
    <div class="address-column">
      <h2>{t('Address')}</h2>
      <address>{footer.address}</address>
      <a class="phone-link" href="tel:+6281959361647">+62 819-5936-1647</a>
      <div class="social-links" aria-label="Social media">
        <a href="https://instagram.com/fixoraastudio" aria-label="Instagram" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor"/></svg></a>
        <a href="https://id.linkedin.com/company/fixorastudio" aria-label="Fixora Studio on LinkedIn" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM3.5 9h3v12h-3V9Zm5.5 0h3v1.6c.8-1.2 1.8-1.9 3.5-1.9 3 0 4.5 1.8 4.5 5.3v7h-3v-6.3c0-2-.5-3-2.2-3-1.8 0-2.8 1.2-2.8 3.2V21H9V9Z"/></svg></a>
        <a href="https://wa.me/+6281959361647" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.5 11.7a8.5 8.5 0 0 1-12.6 7.5L3 21l1.6-5a8.5 8.5 0 1 1 15.9-4.3Z"/><path d="M8 7c-2 3 3 8 6 9 1 .3 3-2 2-3l-2-1-1 1c-1.5-.6-2.4-1.5-3-3l1-1-1-2Z"/></svg></a>
      </div>
    </div>
  </div>
  <div class="copyright">
    <span>© {year} {footer.name}</span>
    <a class="llms-link" href="/llms.txt">llms.txt</a>
  </div>
  <div class="footer-signature" aria-hidden="true">Fixora Studio.</div>
</footer>
<style>
  footer { scroll-margin-top:50px; }
  .footer-grid { display:grid; grid-template-columns:25% 19.5% 19.5% 36%; border-bottom:1px solid var(--line); }
  .footer-grid > * { min-width:0; padding:34px 30px 42px; border-inline-end:1px solid var(--line); }
  .footer-grid > :last-child { border-inline-end:0; }
  .wordmark { display:inline-block; color:#fafafa; font:clamp(24px,2.3vw,32px)/1.05 var(--pixel); letter-spacing:-.05em; white-space:nowrap; }
  p,address { margin:22px 0 0; max-width:310px; color:#999; font-size:14px; line-height:1.6; font-style:normal; }
  h2 { margin:0 0 18px; color:#999; font:12px/1.5 var(--pixel); text-transform:uppercase; }
  ul { display:grid; gap:8px; list-style:none; margin:0; padding:0; }
  .social-links { display:flex; gap:8px; margin-top:20px; }
  .social-links a { display:grid; place-items:center; width:44px; height:44px; color:#999; border:1px solid var(--line); }
  .social-links svg { width:21px; height:21px; }
  .social-links a:hover { color:var(--accent); }
  .social-links a:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
  li a { display:inline-block; padding-block:6px; font-size:14px; line-height:1.5; color:#999; }
  a:hover { color:var(--accent); }
  address { margin:0; }
  .phone-link { display:inline-flex; align-items:center; min-height:44px; margin-top:8px; color:var(--accent); text-decoration:underline; text-underline-offset:4px; }
  .copyright { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:26px 30px; color:#888; font-size:12px; line-height:1.5; border-bottom:1px solid var(--line); }
  .llms-link { flex-shrink:0; display:inline-flex; align-items:center; min-height:24px; text-underline-offset:4px; }
  .llms-link:hover { text-decoration:underline; }
  .llms-link:focus-visible { outline:2px solid var(--accent); outline-offset:5px; }
  .footer-signature { overflow:hidden; height:calc(28px + .65em); padding:18px 20px 0; text-align:center; white-space:nowrap; color:#222; font:clamp(40px,12.5vw,180px)/1.15 var(--pixel); letter-spacing:-.055em; background-image:radial-gradient(#262626 .65px,transparent .65px); background-size:16px 16px; }
  @media(max-width:1000px) {
    .footer-grid { grid-template-columns:1fr 1fr; }
    .footer-grid > :nth-child(2) { border-inline-end:0; }
    .footer-grid > :nth-child(-n+2) { border-bottom:1px solid var(--line); }
  }
  @media(max-width:550px) {
    .footer-grid > * { padding:28px 24px; }
    .brand-column,.address-column { grid-column:1/-1; }
    .footer-grid > .brand-column { border-inline-end:0; }
    .footer-grid > nav:nth-child(2) { border-inline-end:1px solid var(--line); border-bottom:0; }
    .footer-grid > nav:nth-child(3) { border-inline-end:0; }
    .address-column { border-top:1px solid var(--line); }
    .copyright { padding:24px; }
    .footer-signature { padding-inline:12px; }
  }
</style>
